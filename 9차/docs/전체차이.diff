+def _numbers(frame, column):
+    if column not in frame:
+        return None
+    values = pd.to_numeric(frame[column], errors="raise").to_numpy(dtype=float)
+    if not np.isfinite(values).all():
+        raise ValueError(f"유한하지 않은 예측·정답 칼럼: {column}")
+    return values
