+                            "status": "measured" if measured else "unmeasured",
+                            "csv": "hypothesis_results.csv", "png": None}]
+    (output / "hypothesis_results.json").write_text(json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")
+    return result
