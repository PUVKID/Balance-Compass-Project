+"""로컬 연구 결과를 읽기 전용으로 제공한다."""
+import argparse
+import json
+from functools import partial
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from urllib.parse import urlparse, unquote
+import mimetypes
