+def prepare(raw: pd.DataFrame) -> tuple[pd.DataFrame, dict]:
+    data = raw.copy()
+    money = normalize_money(data["보증금(만원)"].tolist() + data["월세금(만원)"].tolist())
+    n = len(data)
+    data["deposit"] = money[:n]
+    data["rent"] = money[n:]
