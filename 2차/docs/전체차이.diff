+ROOT = Path(__file__).resolve().parents[1]
+COLUMNS = ["시군구", "전용면적(㎡)", "계약년월", "계약일", "보증금(만원)", "월세금(만원)", "층", "건축년도", "계약구분"]
+NUMERIC = ["area", "floor", "age", "month"]
