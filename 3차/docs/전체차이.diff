+        if rows != expected:
+            raise ValueError(f"공식 사전 건수 불일치: {month}, 공식={expected}, CSV={rows}")
+        return {"rows": rows, "columns": header, "province_counts": dict(regions), "contract_categories": dict(categories)}
+    finally:
