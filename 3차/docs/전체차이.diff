+            raise
+
+    def normalize(self, month):
+        self.recover(month)
+        record = self.files[month]
+        source = self.checked_path(record["raw_path"])
+        if sha256(source) != record["raw_sha256"]:
+            raise ValueError(f"전처리 직전 원본 SHA 불일치: {month}")
