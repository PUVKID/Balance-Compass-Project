+                rows += 1
+                words = row[region_index].split()
+                regions[words[0] if words else "<미상>"] += 1
+                categories[row[contract_index]] += 1
+                if output is not None:
+                    # 칼럼 선택만 수행한다. 날짜·금액·계약구분 문자열과 정확히 같은 행을 보존한다.
+                    parcel = ["번지"] if "번지" in header else ["본번", "부번"]
