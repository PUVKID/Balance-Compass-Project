+                writer.writerow(columns + ["source_row_id", "cluster_id"])
+            month_index, region_index, contract_index = [header.index(name) for name in ["계약년월", "시군구", "계약구분"]]
+            for row in reader:
+                if not row:
+                    continue
+                if len(row) != len(header):
