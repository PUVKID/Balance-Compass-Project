+def _clean(value):
+    return ' '.join(str(value or '').split())
+
+
+def _day(value):
+    text = _clean(value)
+    if not text:
+        return None
+    if len(text) == 8 and text.isascii() and text.isdigit():
+        return datetime.strptime(text, '%Y%m%d').date()
