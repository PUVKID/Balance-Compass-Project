+BOK_PAGE = 'https://www.bok.or.kr/portal/singl/baseRate/list.do?dataSecd=00001&menuNo=200643'
+METRICS = ['총인구수', '세대수', '세대당 인구', '남자 인구수', '여자 인구수', '남여 비율']
